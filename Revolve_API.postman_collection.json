{
  "info": {
    "name": "Revolve Laravel App",
    "description": "Postman Collection for Revolve E-commerce Laravel Application",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "revolve-app"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000",
      "type": "string"
    },
    {
      "key": "csrf_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "session_cookie",
      "value": "",
      "type": "string"
    }
  ],
  "auth": {
    "type": "noauth"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Auto-extract CSRF token from cookie or response",
          "if (pm.request.headers.has('Cookie')) {",
          "  const cookie = pm.request.headers.get('Cookie').value;",
          "  const xsrfMatch = cookie.match(/XSRF-TOKEN=([^;]+)/);",
          "  if (xsrfMatch) {",
          "    pm.collectionVariables.set('csrf_token', decodeURIComponent(xsrfMatch[1]));",
          "  }",
          "}",
          "",
          "// Add CSRF token to form data if not present",
          "if (pm.request.body && pm.request.body.mode === 'urlencoded') {",
          "  const hasToken = pm.request.body.urlencoded.some(param => param.key === '_token');",
          "  if (!hasToken && pm.collectionVariables.get('csrf_token')) {",
          "    pm.request.body.urlencoded.push({",
          "      key: '_token',",
          "      value: pm.collectionVariables.get('csrf_token'),",
          "      type: 'text'",
          "    });",
          "  }",
          "}"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Save session cookie from response",
          "const cookies = pm.response.headers.get('Set-Cookie');",
          "if (cookies) {",
          "  const sessionMatch = cookies.match(/laravel_session=([^;]+)/);",
          "  if (sessionMatch) {",
          "    pm.collectionVariables.set('session_cookie', 'laravel_session=' + sessionMatch[1]);",
          "  }",
          "}",
          "",
          "// Extract CSRF token from HTML response",
          "const html = pm.response.text();",
          "const tokenMatch = html.match(/name=\"_token\" value=\"([^\"]+)\"/);",
          "if (tokenMatch) {",
          "  pm.collectionVariables.set('csrf_token', tokenMatch[1]);",
          "}",
          "",
          "// Basic response validation",
          "pm.test('Response received', function () {",
          "  pm.expect(pm.response.code).to.be.oneOf([200, 302, 422]);",
          "});"
        ]
      }
    }
  ],
